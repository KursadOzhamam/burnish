    "settings.launchAtLogin": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılınca başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        }
      }
    },
    "settings.menuBar": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğunda göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in the menu bar"
          }
        }
      }
    },
    "settings.deletion.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen her şey önce Çöp'e taşınır; kalıcı silme yalnızca Parçalayıcı ve Çöp'ü boşaltma ile, ek onayla yapılır. Hiçbir ayar onaysız silme açmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything removed goes to the Trash first; permanent deletion exists only in the shredder and when emptying the Trash, with extra confirmation. No setting enables deleting without approval."
          }
        }
      }
    },
    "settings.scanners.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattığın tarayıcılar Temizlik ve Akıllı Tarama'da çalışmaz. Dil dosyaları gibi riskli olanlar varsayılan kapalıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanners you switch off do not run in Cleanup or Smart Scan. Risky ones, like language files, are off by default."
          }
        }
      }
    },
    "settings.fullDiskAccess": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access"
          }
        }
      }
    },
    "settings.granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verildi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        }
      }
    },
    "settings.notGranted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilmedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not granted"
          }
        }
      }
    },
    "settings.unknown": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlenemedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "settings.openSettings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ı aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "settings.helper": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı (yönetici işlemleri)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper (administrator tasks)"
          }
        }
      }
    },
    "settings.helper.enabled": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active"
          }
        }
      }
    },
    "settings.helper.approval": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekliyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval"
          }
        }
      }
    },
    "settings.helper.off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu değil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed"
          }
        }
      }
    },
    "settings.helperInstall": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        }
      }
    },
    "settings.crashReports": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çökme raporu gönder"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send crash reports"
          }
        }
      }
    },
    "settings.crashReports.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan kapalı. Henüz hiçbir şey gönderilmiyor; ileride açarsan göndermeden önce raporun ham halini göreceksin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Nothing is sent yet; if you turn this on later you will see the raw report before it is sent."
          }
        }
      }
    },
    "settings.noData": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya adların, yolların ve disk içeriğin hiçbir koşulda dışarı gönderilmez. Kullanım istatistiği toplanmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your file names, paths and disk contents are never sent anywhere. No usage statistics are collected."
          }
        }
      }
    },
    "settings.uninstall.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish'ı tamamen kaldırır: yardımcıyı ve oturum öğesini söker, verilerini Çöp'e taşır, ardından uygulamayı da Çöp'e taşımayı önerir. Önce neyin gideceği listelenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes Burnish completely: unregisters the helper and login item, moves its data to the Trash, then offers to move the app to the Trash too. What will go is listed first."
          }
        }
      }
    },
    "settings.uninstall.show": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelerin kaldırılacağını göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what would be removed"
          }
        }
      }
    },
    "settings.uninstall.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırılacak veri bulunamadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data to remove was found."
          }
        }
      }
    },
    "settings.uninstall.run": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish'ın verilerini kaldır…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Burnish's data…"
          }
        }
      }
    },
    "settings.uninstall.done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı. Uygulamanın kendisi için aşağıdaki düğmeyi kullan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Use the button below for the app itself."
          }
        }
      }
    },
    "settings.uninstall.trashApp": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı Çöp'e taşı ve çık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the app to the Trash and quit"
          }
        }
      }
    },
    "onboarding.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish'a hoş geldin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Burnish"
          }
        }
      }
    },
    "onboarding.promise.trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey sana sorulmadan kalıcı silinmez: her şey önce Çöp'e gider ve geri alınabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is permanently deleted without asking: everything goes to the Trash first and can be restored."
          }
        }
      }
    },
    "onboarding.promise.preview": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her temizlik önce ne gideceğini gösterir; onaylamadan hiçbir şey değişmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cleanup shows what will go first; nothing changes until you approve."
          }
        }
      }
    },
    "onboarding.promise.honest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçemediğimiz bir hızlanma ya da kazanç vaat etmeyiz; rakamlar gerçek bayt sayılarıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We make no promise of speed-ups or gains we cannot measure; the numbers are real byte counts."
          }
        }
      }
    },
    "onboarding.promise.private": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya adların, yolların ve içeriğin Mac'inden dışarı çıkmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your file names, paths and contents never leave your Mac."
          }
        }
      }
    },
    "onboarding.access.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik bir izin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One permission, once"
          }
        }
      }
    },
    "onboarding.access.body": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi verirsen macOS, her klasör için ayrı ayrı sormaz ve Burnish daha fazlasını görebilir. Vermezsen de uygulama çalışır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you grant Full Disk Access, macOS stops asking folder by folder and Burnish can see more. The app works without it too."
          }
        }
      }
    },
    "onboarding.access.open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ı aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "onboarding.access.granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi verilmiş"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access is granted"
          }
        }
      }
    },
    "onboarding.access.optional": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstersen şimdi atlayabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this for now."
          }
        }
      }
    },
    "onboarding.start.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırsın"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are ready"
          }
        }
      }
    },
    "onboarding.start.body": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel Bakış'tan Akıllı Tarama'yı başlatabilir ya da soldaki bölümlerden istediğini seçebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Smart Scan from the overview, or pick any section on the left."
          }
        }
      }
    },
    "onboarding.skip": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        }
      }
    },
    "onboarding.back": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "onboarding.next": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "onboarding.finish": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla"
          }
        },
        "en": {
          "stringUnit": {
