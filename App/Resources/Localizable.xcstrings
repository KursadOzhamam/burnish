    "settings.menuBar": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğunda göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in the menu bar"
          }
        }
      }
    },
    "settings.language.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil, sistem diline göre Türkçe ya da İngilizce olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language follows your system: Turkish or English."
          }
        }
      }
    },
    "settings.deletion.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinen her şey önce Çöp'e taşınır; kalıcı silme yalnızca Parçalayıcı ve Çöp'ü boşaltma ile, ek onayla yapılır. Hiçbir ayar onaysız silme açmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything removed goes to the Trash first; permanent deletion exists only in the shredder and when emptying the Trash, with extra confirmation. No setting enables deleting without approval."
          }
        }
      }
    },
    "settings.scanners.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattığın tarayıcılar Temizlik ve Akıllı Tarama'da çalışmaz. Dil dosyaları gibi riskli olanlar varsayılan kapalıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanners you switch off do not run in Cleanup or Smart Scan. Risky ones, like language files, are off by default."
          }
        }
      }
    },
    "settings.fullDiskAccess": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access"
          }
        }
      }
    },
    "settings.granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verildi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted"
          }
        }
      }
    },
    "settings.notGranted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilmedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not granted"
          }
        }
      }
    },
    "settings.unknown": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlenemedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
