{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "deletion.confirm.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinecekler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will be removed"
          }
        }
      }
    },
    "deletion.confirm.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler Çöp Kutusu'na taşınır. İstediğin zaman geri alabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items are moved to the Trash. You can restore them any time."
          }
        }
      }
    },
    "deletion.confirm.permanentWarning": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler kalıcı olarak silinir. Geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items are deleted permanently. This cannot be undone."
          }
        }
      }
    },
    "deletion.confirm.moveToTrash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e Taşı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        }
      }
    },
    "deletion.confirm.deletePermanently": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı Olarak Sil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Permanently"
          }
        }
      }
    },
    "deletion.confirm.noHistory": {
      "comment": "Warns that this run will not be recorded, so it cannot be restored from the app.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme kaydı tutulamıyor. Öğeler Çöp'e gider ama buradan geri yüklenemez; Finder'daki Çöp'ten alabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restore log cannot be kept. Items go to the Trash but cannot be restored from here; you can take them back from the Trash in Finder."
          }
        }
      }
    },
    "deletion.result.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazanılan alan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space reclaimed"
          }
        }
      }
    },
    "deletion.result.failures %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe silinemedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items could not be removed"
          }
        }
      }
    },
    "deletion.summary %lld %@": {
      "comment": "Item count and total size, e.g. '145 öğe · 5,4 GB'.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld öğe · %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items · %2$@"
          }
        }
      }
    },
    "deletion.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "deletion.blocked.needsHelper": {
      "comment": "Honest about a capability that does not exist yet.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem izni gerekiyor — bu yetenek henüz eklenmedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs administrator access, which is not available yet"
          }
        }
      }
    },
    "deletion.blocked.ownerRunning": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açık, atlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is open, skipped"
          }
        }
      }
    },
    "deletion.blocked.protectedPath": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan yol — hiçbir koşulda silinmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected path, never removed"
          }
        }
      }
    },
    "deletion.blocked.nested": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstteki öğenin içinde, ayrıca sayılmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside an item above, not counted separately"
          }
        }
      }
    },
    "deletion.blocked.other": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarayıcının kapsamı dışında"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside this scanner's scope"
          }
        }
      }
    },
    "deletion.result.done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    }
  }
}
