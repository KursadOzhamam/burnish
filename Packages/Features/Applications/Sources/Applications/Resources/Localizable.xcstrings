{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "apps.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications"
          }
        }
      }
    },
    "apps.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü uygulamaları ve geride bıraktıkları dosyaları gösterir. Hiçbir şey önceden seçilmez, yalnızca Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows installed applications and the files they leave behind. Nothing is preselected and items only go to the Trash."
          }
        }
      }
    },
    "apps.tab.apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applications"
          }
        }
      }
    },
    "apps.tab.orphans": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık dosyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leftovers"
          }
        }
      }
    },
    "apps.search": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama ara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search applications"
          }
        }
      }
    },
    "apps.sort.name": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "apps.sort.size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "apps.sort.lastUsed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kullanım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last used"
          }
        }
      }
    },
    "apps.sort": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırala"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort"
          }
        }
      }
    },
    "apps.unused": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "90 gündür açılmayanlar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opened for 90 days"
          }
        }
      }
    },
    "apps.showApple": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple uygulamalarını göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Apple apps"
          }
        }
      }
    },
    "apps.uninstall": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldır…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall…"
          }
        }
      }
    },
    "apps.loading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar okunuyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading applications…"
          }
        }
      }
    },
    "apps.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterilecek uygulama yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No applications to show"
          }
        }
      }
    },
    "apps.neverOpened": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kullanım bilinmiyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last use unknown"
          }
        }
      }
    },
    "apps.apple": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple uygulaması: kaldırılamaz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple app: cannot be removed"
          }
        }
      }
    },
    "apps.running": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "apps.quit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı kapat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the app"
          }
        }
      }
    },
    "apps.runningNote": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açıkken kaldırılmaz. Kapatınca tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open app is not removed. Quit it and try again."
          }
        }
      }
    },
    "apps.review.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldırma önizlemesi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal preview"
          }
        }
      }
    },
    "apps.review.app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application"
          }
        }
      }
    },
    "apps.review.leftovers": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geride kalanlar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leftovers"
          }
        }
      }
    },
    "apps.review.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geride kalan dosya bulunamadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leftover files were found."
          }
        }
      }
    },
    "apps.review.lowNote": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca adı eşleşenler işaretsiz gelir: bir ad kimlik değildir. Gerekirse kendin işaretle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items matched only by name start unticked: a name is not an identity. Tick them yourself if needed."
          }
        }
      }
    },
    "apps.review.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "apps.review.trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e taşı…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash…"
          }
        }
      }
    },
    "apps.review.loading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıklar aranıyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for leftovers…"
          }
        }
      }
    },
    "apps.orphans.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinmiş uygulamalardan kalmış gibi görünen klasörler. Bu bir tahmindir: hiçbiri önceden seçilmez, Apple'ın dosyaları ve geliştirici araçları listelenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders that look left over from deleted apps. This is a guess: nothing is preselected, and Apple's files and developer tools are not listed."
          }
        }
      }
    },
    "apps.orphans.scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıkları tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan for leftovers"
          }
        }
      }
    },
    "apps.orphans.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık dosya bulunamadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leftovers found"
          }
        }
      }
    },
    "apps.orphans.trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e taşı…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash…"
          }
        }
      }
    },
    "apps.done": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "apps.count %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld uygulama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld applications"
          }
        }
      }
    },
    "apps.selected %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe seçili · %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items selected · %@"
          }
        }
      }
    },
    "apps.lastUsed %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gün önce açıldı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "opened %lld days ago"
          }
        }
      }
    },
    "apps.orphans.found %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klasör · %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld folders · %@"
          }
        }
