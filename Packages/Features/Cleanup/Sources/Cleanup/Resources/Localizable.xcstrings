    "cleanup.landing.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereksiz dosyaları bulun, Mac'inizde yer açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find files you do not need and free up space on your Mac."
          }
        }
      }
    },
    "cleanup.landing.hero.heading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha temiz bir Mac için ilk adım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first step to a cleaner Mac"
          }
        }
      }
    },
    "cleanup.landing.hero.message": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem artıkları ve gereksiz dosyalar için tarama başlatın. Temizlemeden önce tüm sonuçları inceleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a scan for system leftovers and files you do not need. Review every result before cleaning."
          }
        }
      }
    },
    "cleanup.landing.hero.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinecek dosyalar sizin onayınızla seçilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What gets removed is chosen with your approval."
          }
        }
      }
    },
    "cleanup.landing.list": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama kapsamı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan scope"
          }
        }
      }
    },
    "cleanup.landing.selected %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kategori seçili"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld categories selected"
          }
        }
      }
    },
    "cleanup.landing.included": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included"
          }
        }
      }
    },
    "cleanup.landing.excluded": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded"
          }
        }
      }
    },
    "cleanup.landing.notScanned": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz taranmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not scanned yet"
          }
        }
      }
    },
    "cleanup.landing.info.heading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol sizde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in control"
          }
        }
      }
    },
    "cleanup.landing.info.message": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama dosyalarınızı silmez. Sonuçları inceleyip temizlenecek öğelere kendiniz karar verirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning never deletes your files. You review the results and decide what gets cleaned."
          }
        }
      }
    },
    "cleanup.landing.info.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel belgeleriniz ve fotoğraflarınız bu tarama kapsamına alınmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal documents and photos are not part of this scan."
          }
        }
      }
    },
    "cleanup.landing.info.button": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıları yönet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage scanners"
          }
        }
      }
    },
    "cleanup.landing.lastScan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tarama: Henüz yapılmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last scan: not yet"
          }
        }
      }
    },
    "cleanup.landing.footer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazanılabilecek alan, taramadan sonra hesaplanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space you can gain is calculated after the scan."
          }
        }
      }
    },
    "cleanup.landing.action": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramayı Başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Scan"
          }
        }
      }
    },
    "privacy.landing.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijital izlerinizi inceleyin, kişisel verilerinizin kontrolünü elinizde tutun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your digital traces and keep control of your personal data."
          }
        }
      }
    },
    "privacy.landing.hero.heading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel verileriniz, sizin kararınız"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal data, your decision"
          }
        }
      }
    },
    "privacy.landing.hero.message": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı verilerini ve kullanım izlerini inceleyin. Temizlemek istediğiniz verileri ayrı ayrı seçin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review browser data and usage traces. Choose the data you want to clear one by one."
          }
        }
      }
    },
    "privacy.landing.hero.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey önceden seçilmez; dosyalar Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is preselected; files go to the Trash."
          }
        }
      }
    },
    "privacy.landing.list": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy areas"
          }
        }
      }
    },
    "privacy.landing.info.heading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlemeden önce"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you clear"
          }
        }
      }
    },
    "privacy.landing.info.message": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezleri silmek web sitelerindeki oturumlarınızı kapatabilir. Tarayıcı açıkken işlem yapılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing cookies can sign you out of websites. Nothing happens while the browser is open."
          }
        }
      }
    },
    "privacy.landing.info.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş parolalar bu temizlik kapsamına alınmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved passwords are not part of this cleanup."
          }
        }
      }
    },
    "privacy.landing.footer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnceleme verilerinizi silmez veya izinlerinizi değiştirmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewing does not delete your data or change your permissions."
          }
        }
      }
    },
    "privacy.landing.action": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Analizi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Analysis"
          }
        }
      }
    },
    "cleanup.packageManagerCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket yöneticisi önbellekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package manager caches"
          }
        }
      }
    },
    "cleanup.packageManagerCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "npm, Gradle, CocoaPods, pnpm, Yarn ve Go'nun indirme önbellekleri. Bir şey kaybolmaz, ama bir sonraki kurulum veya derleme her şeyi yeniden indirir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download caches of npm, Gradle, CocoaPods, pnpm, Yarn and Go. Nothing is lost, but the next install or build downloads everything again."
          }
        }
      }
    },
    "cleanup.toolCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut satırı araçlarının önbellekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command-line tool caches"
          }
        }
      }
    },
    "cleanup.toolCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.cache klasörü: pip, uv, Hugging Face, Puppeteer ve benzerleri. İndirilmiş yapay zekâ modelleri burada olabilir; ilk kullanımda yeniden indirilir, bu uzun sürebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ~/.cache folder: pip, uv, Hugging Face, Puppeteer and similar tools. Downloaded machine-learning models may be here; they are fetched again on next use, which can take long."
          }
        }
      }
    },
    "privacy.chromiumProfiles.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer tarayıcı profilleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other browser profiles"
          }
        }
      }
    },
    "privacy.chromiumProfiles.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome, Brave, Edge, Arc ve Vivaldi'nin ek profillerindeki ve misafir profilindeki geçmiş, çerezler ve form verileri. Kayıtlı parolalara dokunulmaz; tarayıcı açıkken atlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History, cookies and form data in the extra and guest profiles of Chrome, Brave, Edge, Arc and Vivaldi. Saved passwords are never touched; skipped while the browser is open."
          }
        }
      }
    },
    "privacy.firefox.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Firefox izleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firefox traces"
          }
        }
      }
    },
    "privacy.firefox.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezler, form geçmişi ve kayıtlı oturum. Geçmiş, yer imleriyle aynı dosyada tutulduğu için listelenmez; tarayıcı açıkken atlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cookies, form history and the saved session. History is not listed because Firefox keeps it in the same file as bookmarks; skipped while the browser is open."
          }
        }
      }
    },
    "privacy.downloadLog.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme kaydı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download log"
          }
        }
      }
    },
    "privacy.downloadLog.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'un internetten indirilen her dosya için tuttuğu kayıt: kaynak adres, tarih ve indiren uygulama. Gerektiğinde yeniden oluşturulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record macOS keeps of every file downloaded from the internet: source address, date and the app that fetched it. Recreated when needed."
          }
        }
      }
    },
    "privacy.label.downloadLog": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme kaydı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download log"
          }
        }
      }
    }
  },
  "version": "1.0"
}