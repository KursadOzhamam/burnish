{
  "sourceLanguage": "en",
  "strings": {
    "cleanup.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup"
          }
        }
      }
    },
    "cleanup.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereksiz dosyaları bulur. Ne silineceğini görmeden hiçbir şey silinmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds files you do not need. Nothing is removed until you have seen what it is."
          }
        }
      }
    },
    "cleanup.action.scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramayı Başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Scan"
          }
        }
      }
    },
    "cleanup.action.review": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilenleri İncele"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Selected"
          }
        }
      }
    },
    "cleanup.action.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "cleanup.action.selectAll": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü seç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all"
          }
        }
      }
    },
    "cleanup.action.deselectAll": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimi kaldır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deselect"
          }
        }
      }
    },
    "cleanup.empty.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlenecek bir şey yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean up"
          }
        }
      }
    },
    "cleanup.empty.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te şu an kayda değer önbellek birikmemiş. Birkaç gün kullandıktan sonra tekrar bak."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notable cache has built up on this Mac. Check again after a few days of use."
          }
        }
      }
    },
    "cleanup.blocked.needsHelper": {
      "comment": "Honest about a capability that does not exist yet.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem izni gerekiyor — bu yetenek henüz eklenmedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs administrator access, which is not available yet"
          }
        }
      }
    },
    "cleanup.blocked.ownerRunning": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açık, atlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is open, skipped"
          }
        }
      }
    },
    "cleanup.blocked.protectedPath": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan yol — hiçbir koşulda silinmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected path, never removed"
          }
        }
      }
    },
    "cleanup.blocked.nested": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstteki öğenin içinde, ayrıca sayılmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside an item above, not counted separately"
          }
        }
      }
    },
    "cleanup.blocked.other": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarayıcının kapsamı dışında"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside this scanner's scope"
          }
        }
      }
    },
    "cleanup.summary %lld %@": {
      "comment": "Item count and total size, e.g. '145 öğe · 5,4 GB'.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld öğe · %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items · %2$@"
          }
        }
      }
    },
    "cleanup.selected %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld öğe seçildi · %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items selected · %2$@"
          }
        }
      }
    },
    "cleanup.skipped %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe atlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items skipped"
          }
        }
      }
    },
    "cleanup.userCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama önbellekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches"
          }
        }
      }
    },
    "cleanup.userCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaların hızlanmak için sakladığı geçici dosyalar. Silinince uygulamalar bunları gerektiğinde yeniden oluşturur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files apps keep to run faster. Apps recreate them when needed."
          }
        }
      }
    },
    "cleanup.userLogs.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük dosyaları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log files"
          }
        }
      }
    },
    "cleanup.userLogs.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaların tuttuğu tanı kayıtları. Bir sorunu bildirmeyi planlamıyorsan gerekmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic records apps keep. You do not need them unless you plan to report a problem."
          }
        }
      }
    },
    "cleanup.developerJunk.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici artıkları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer leftovers"
          }
        }
      }
    },
    "cleanup.developerJunk.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode derleme çıktıları ve paket yöneticisi önbellekleri. Bir sonraki derlemede yeniden üretilir — ama o derleme daha uzun sürer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode build output and package manager caches. They are regenerated on the next build, which then takes longer."
          }
        }
      }
    },
    "cleanup.browserCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı önbellekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser caches"
          }
        }
      }
    },
    "cleanup.browserCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari, Chrome, Firefox, Edge, Brave ve Arc'ın sakladığı sayfa verileri. Açık olan tarayıcılar atlanır. Geçmişine ve parolalarına dokunulmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page data saved by Safari, Chrome, Firefox, Edge, Brave and Arc. Open browsers are skipped. Your history and passwords are not touched."
          }
        }
      }
    },
    "cleanup.mailDownloads.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail ek indirmeleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail attachment downloads"
          }
        }
      }
    },
    "cleanup.mailDownloads.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığın eklerin yerel kopyaları. Postaların ve posta veritabanın korunur; gerekirse ek yeniden indirilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local copies of attachments you opened. Your mail and the mail database are kept; an attachment is downloaded again if needed."
          }
        }
      }
    },
    "cleanup.mobileBackups.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad yedekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone and iPad backups"
          }
        }
      }
    },
    "cleanup.mobileBackups.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz yedekleri ve indirilmiş yazılım güncellemeleri. Bir yedek cihazının tek kopyası olabilir — bu yüzden hiçbiri önceden seçilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device backups and downloaded software updates. A backup can be the only copy of a device, so nothing is preselected."
          }
        }
      }
    },
    "cleanup.userTrash.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        }
      }
    },
    "cleanup.userTrash.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'ü boşaltmak tanımı gereği kalıcıdır; bu öğeler Çöp'e taşınmaz, silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emptying the Trash is permanent by definition; these items are deleted, not moved to the Trash."
          }
        }
      }
    },
    "cleanup.systemCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem önbellekleri ve günlükleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System caches and logs"
          }
        }
      }
    },
    "cleanup.systemCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici izni gerektiren sistem klasörleri. Ne olduğunu görebilirsin; silme yeteneği henüz eklenmedi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System folders that need administrator access. You can see what is there; removal is not available yet."
          }
        }
      }
    },
    "cleanup.permission.required": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin gerekli"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission needed"
          }
        }
      }
    },
    "cleanup.permission.banner": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı, çünkü Burnish'in Tam Disk Erişimi yok. İzin vermeden de çalışır, ama bu klasörler taranamaz ve sonuçlara dahil değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders could not be read because Burnish does not have Full Disk Access. It works without it, but those folders are not scanned and are not in the results."
          }
        }
      }
    },
    "cleanup.permission.open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nı Aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        }
      }
    },
    "cleanup.permission.unreadable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunamadı (Tam Disk Erişimi gerekli)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not be read (Full Disk Access needed)"
          }
        }
      }
    },
    "cleanup.xcodeDeviceSupport.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode cihaz desteği"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode device support"
          }
        }
      }
    },
    "cleanup.xcodeDeviceSupport.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode'un bağladığın iPhone, iPad ve diğer cihazlar için sakladığı hata ayıklama sembolleri. Cihaz tekrar bağlanınca yeniden oluşturulur, ama ilk bağlanışta birkaç dakika sürer. Bu yüzden hiçbiri önceden seçilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug symbols Xcode keeps for the iPhones, iPads and other devices you connected. They are rebuilt when the device is connected again, but the first sync takes a few minutes, so nothing is preselected."
          }
        }
      }
    },
    "cleanup.xcodeArchives.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode arşivleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode archives"
          }
        }
      }
    },
    "cleanup.xcodeArchives.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınladığın sürümlerin arşivleri. Eski bir sürümün çökme raporunu çözmek için gereken semboller yalnızca burada olabilir, bu yüzden hiçbiri önceden seçilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives of the builds you shipped. The symbols needed to read a crash report from an old version may exist only here, so nothing is preselected."
          }
        }
      }
    },
    "cleanup.appCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama önbellekleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App caches"
          }
        }
      }
    },
    "cleanup.appCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notion, Figma, Claude, Cursor ve VS Code gibi uygulamaların yeniden oluşturulabilen önbellek klasörleri. Yalnızca önbellek klasörünün kendisi listelenir; ayarlar ve verilerin dokunulmaz. Uygulama açıkken atlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuildable cache folders of apps such as Notion, Figma, Claude, Cursor and VS Code. Only the cache folder itself is listed; your settings and data are never touched. Skipped while the app is open."
          }
        }
      }
    },
    "cleanup.adobeMediaCaches.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe medya önbelleği"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe media cache"
          }
        }
      }
    },
    "cleanup.adobeMediaCaches.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiere Pro, Audition ve diğer Adobe uygulamalarının ortak önbellek ve dalga biçimi dosyaları. Proje kaybolmaz, ama büyük projelerde yeniden oluşması uzun sürebilir; bu yüzden hiçbiri önceden seçilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared cache and waveform files of Premiere Pro, Audition and other Adobe apps. No project is lost, but rebuilding can take long on large projects, so nothing is preselected."
          }
        }
      }
    },
    "cleanup.brokenPreferences.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk tercih dosyaları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broken preference files"
          }
        }
      }
    },
    "cleanup.brokenPreferences.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş olan veya okunup çözümlenemeyen .plist dosyaları. Yalnızca gerçekten bozuk olanlar listelenir; izin yüzünden açılamayanlar ve Apple'ın kendi dosyaları listelenmez. Sahibi uygulama dosyayı yeniden oluşturur; bu yüzden hiçbiri önceden seçilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty .plist files, or ones that are read but cannot be parsed. Only truly broken files are listed; files that cannot be opened for lack of permission, and Apple's own files, are not. The owning app recreates the file, so nothing is preselected."
          }
        }
      }
    },
    "cleanup.downloads.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads"
          }
        }
      }
    },
    "cleanup.downloads.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum dosyaları (.dmg, .pkg, .iso, .xip) ve 30 günden uzun süredir dokunulmamış öğeler. Burası senin içeriğin: hiçbiri önceden seçilmez, yalnızca Çöp'e taşınır ve indirilmekte olan dosyalar listelenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers (.dmg, .pkg, .iso, .xip) and items untouched for over 30 days. This is your own content: nothing is preselected, items only go to the Trash, and files still downloading are not listed."
          }
        }
      }
    },
    "privacy.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "privacy.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı geçmişi, çerezler ve son kullanılan öğeler. Bunlar senin verin: hiçbiri önceden seçilmez, tarayıcı açıkken işlem yapılmaz. Dosyalar Çöp'e taşınır; iz gerçekten Çöp'ü boşaltınca gider. Çerezleri silmek sitelerdeki oturumlarını kapatır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser history, cookies and recent items. This is your data: nothing is preselected and nothing happens while the browser is open. Files go to the Trash; the trace is really gone once you empty it. Removing cookies signs you out of sites."
          }
        }
      }
    },
    "privacy.safari.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari izleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari traces"
          }
        }
      }
    },
    "privacy.safari.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş, son oturum ve çerezler. Tam Disk Erişimi gerekir; Safari açıkken atlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History, last session and cookies. Needs Full Disk Access; skipped while Safari is open."
          }
        }
      }
    },
    "privacy.chromium.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
