          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending updates"
          }
        }
      }
    },
    "dashboard.factor.startupLoad": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç öğeleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startup items"
          }
        }
      }
    },
    "dashboard.purgeable.note %@": {
      "comment": "Explains that purgeable space is not a cleanup gain. CLAUDE.md §10.4.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun %@ kadarı macOS'un gerektiğinde kendi boşaltacağı alan; Burnish bunu kazanç saymıyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of this is space macOS frees on its own when needed; Burnish does not count it as a gain."
          }
        }
      }
    },
    "dashboard.score.points %lld %lld": {
      "comment": "Points earned out of available, e.g. 24/30.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld puan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld points"
          }
        }
      }
    },
    "dashboard.metric.network.detail": {
      "comment": "Clarifies that network figures are per second.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "saniyede indirme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "download per second"
          }
        }
      }
    },
    "dashboard.metric.disk.detail %@": {
      "comment": "Free space out of total, e.g. '1 TB icinde bos'.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "toplam %@ içinde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "of %@ total"
          }
        }
      }
    },
    "dashboard.metric.disk.free": {
      "comment": "Tile title. States plainly that the value is free space, not used.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş disk alanı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free disk space"
          }
        }
      }
    }
  },
  "version": "1.0"
}
