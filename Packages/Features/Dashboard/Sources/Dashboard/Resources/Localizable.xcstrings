{
  "sourceLanguage": "en",
  "strings": {
    "dashboard.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel Bakış"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview"
          }
        }
      }
    },
    "dashboard.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inin durumu, tek bakışta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac's condition, at a glance."
          }
        }
      }
    },
    "dashboard.health.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık skoru"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health score"
          }
        }
      }
    },
    "dashboard.health.explain": {
      "comment": "Link that opens the score breakdown.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl hesaplandı?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How is this calculated?"
          }
        }
      }
    },
    "dashboard.health.neverScanned": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz tarama yapılmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scan has been run yet"
          }
        }
      }
    },
    "dashboard.scan.action": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıllı Tarama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan"
          }
        }
      }
    },
