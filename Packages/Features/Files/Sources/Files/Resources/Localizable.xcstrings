    "files.dup.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds files with exactly the same content. Every group always keeps at least one copy; nothing is preselected and files only go to the Trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği birebir aynı olan dosyaları bulur. Her grupta en az bir kopya her zaman kalır; hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        }
      }
    },
    "files.dup.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate files"
