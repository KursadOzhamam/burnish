    },
    "files.shred.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı olarak sil…"
          }
        }
      }
    },
    "files.shred.drop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files here or press Add files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları buraya bırak ya da Dosya ekle'ye bas"
          }
        }
      }
    },
    "files.shred.honest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honest note: on SSDs and APFS, overwriting a file does not guarantee the old data is gone (copy-on-write, wear levelling, TRIM). Burnish does not pretend to overwrite; it deletes the file permanently. For real protection, turn on FileVault."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürüst not: SSD'lerde ve APFS'te dosyanın üzerine yazmak, eski verinin gittiğini garanti etmez (kopyala-yaz, aşınma dengeleme, TRIM). Burnish üzerine yazıyormuş gibi davranmaz; dosyayı kalıcı olarak siler. Gerçek güvenlik için FileVault'u aç."
          }
        }
      }
    },
    "files.shred.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from list"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeden çıkar"
          }
        }
      }
    },
    "files.shred.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the files you choose. They do not go to the Trash and cannot be restored. Only files you add are touched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin dosyaları kalıcı olarak siler. Çöp'e gitmez, geri alınamaz. Yalnızca senin eklediğin dosyalara dokunur."
          }
        }
      }
    },
    "files.shred.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shredder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalayıcı"
          }
        }
      }
    },
    "files.similar.empty.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no groups of look-alike pictures in the chosen folders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasörlerde birbirine benzeyen görsel grubu yok."
          }
        }
      }
    },
    "files.similar.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No similar pictures found"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzer görsel bulunmadı"
          }
        }
      }
    },
    "files.similar.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds pictures that look very alike (bursts, retakes). Analysis happens on this Mac and nothing is sent anywhere. Every group keeps at least one; nothing is preselected and files only go to the Trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirine çok benzeyen görselleri (seri çekim, tekrar çekim) bulur. Hesaplama bu Mac'te yapılır, görseller dışarı gönderilmez. Her grupta en az biri kalır; hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        }
      }
    },
    "files.similar.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar pictures"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzer görseller"
          }
        }
      }
    },
    "files.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the largest files in your home folders. They are all your own content: nothing is preselected and files only go to the Trash."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev klasöründeki en büyük dosyaları bulur. Hepsi senin içeriğin: hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        }
      }
    },
    "files.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large and old files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük ve eski dosyalar"
          }
        }
      }
    },
    "files.unused %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "untouched for %lld days"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gündür dokunulmadı"
          }
        }
      }
    }
