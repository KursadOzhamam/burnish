{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "files.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük ve eski dosyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large and old files"
          }
        }
      }
    },
    "files.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev klasöründeki en büyük dosyaları bulur. Hepsi senin içeriğin: hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the largest files in your home folders. They are all your own content: nothing is preselected and files only go to the Trash."
          }
        }
      }
    },
    "files.action.scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        }
      }
    },
    "files.action.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "files.action.trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e taşı…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash…"
          }
        }
      }
    },
    "files.action.rescan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        }
      }
    },
    "files.empty.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosya bulunmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No large files found"
          }
        }
      }
    },
    "files.empty.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasörlerde 100 MB üzeri dosya yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no files over 100 MB in the chosen folders."
          }
        }
      }
    },
    "files.partial": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama durduruldu: yalnızca o ana kadar bulunanlar gösteriliyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan stopped: only what was found so far is shown."
          }
        }
      }
    },
    "files.permission": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı. Tam Disk Erişimi verirsen daha fazlası görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders could not be read. Grant Full Disk Access to see more."
          }
        }
      }
    },
    "files.filter.kind": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
    },
    "files.filter.age": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kullanım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last used"
          }
        }
      }
    },
    "files.filter.kind.all": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümü"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "files.kind.video": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video"
          }
        }
      }
    },
    "files.kind.audio": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        }
      }
    },
    "files.kind.image": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        }
      }
    },
    "files.kind.archive": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive"
          }
        }
      }
    },
    "files.kind.diskImage": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk kalıbı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk image"
          }
        }
      }
    },
    "files.kind.document": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document"
          }
        }
      }
    },
    "files.kind.other": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        }
      }
    },
    "files.age.any": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark etmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any time"
          }
        }
      }
    },
    "files.age.90": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "90 günden eski"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 90 days"
          }
        }
      }
    },
    "files.age.365": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 yıldan eski"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 1 year"
          }
        }
      }
    },
    "files.cloud": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bir bulut klasöründe (iCloud, Creative Cloud) olabilir; silmek buluttaki kopyayı da etkileyebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file may be in a cloud-synced folder (iCloud, Creative Cloud); removing it can affect the cloud copy too."
          }
        }
      }
    },
    "files.selected %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosya seçili · %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files selected · %@"
          }
        }
      }
    },
    "files.found %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosya"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files"
          }
        }
      }
    },
    "files.remaining %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ kaldı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ left"
          }
        }
      }
    },
    "files.unused %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gündür dokunulmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "untouched for %lld days"
          }
        }
      }
    }
  }
}