    "files.dup.empty.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no two files over 1 MB with the same content."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB üzeri, içeriği aynı iki dosya yok."
          }
