{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "files.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük ve eski dosyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large and old files"
          }
        }
      }
    },
    "files.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev klasöründeki en büyük dosyaları bulur. Hepsi senin içeriğin: hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds the largest files in your home folders. They are all your own content: nothing is preselected and files only go to the Trash."
          }
        }
      }
    },
    "files.action.scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        }
      }
    },
    "files.action.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "files.action.trash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e taşı…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash…"
          }
        }
      }
    },
    "files.action.rescan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        }
      }
    },
    "files.empty.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosya bulunmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No large files found"
          }
        }
      }
    },
    "files.empty.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen klasörlerde 100 MB üzeri dosya yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no files over 100 MB in the chosen folders."
          }
        }
      }
    },
    "files.partial": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama durduruldu: yalnızca o ana kadar bulunanlar gösteriliyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan stopped: only what was found so far is shown."
          }
        }
      }
    },
    "files.permission": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı. Tam Disk Erişimi verirsen daha fazlası görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders could not be read. Grant Full Disk Access to see more."
          }
        }
      }
    },
