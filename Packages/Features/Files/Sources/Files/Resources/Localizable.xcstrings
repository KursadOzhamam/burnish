      }
    },
    "files.age.90": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "90 günden eski"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 90 days"
          }
        }
      }
    },
    "files.age.365": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 yıldan eski"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 1 year"
          }
        }
      }
    },
    "files.cloud": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya bir bulut klasöründe (iCloud, Creative Cloud) olabilir; silmek buluttaki kopyayı da etkileyebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file may be in a cloud-synced folder (iCloud, Creative Cloud); removing it can affect the cloud copy too."
          }
        }
      }
    },
    "files.selected %lld %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosya seçili · %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files selected · %@"
          }
        }
      }
    },
    "files.found %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dosya"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files"
          }
        }
      }
    },
    "files.remaining %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ kaldı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ left"
          }
        }
      }
    },
    "files.unused %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gündür dokunulmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "untouched for %lld days"
          }
        }
      }
    },
    "files.hub.large": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük dosyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large files"
          }
        }
      }
    },
    "files.hub.map": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan haritası"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space map"
          }
        }
      }
    },
    "files.map.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan haritası"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space map"
          }
        }
      }
    },
    "files.map.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev klasörünün neyin ne kadar yer kapladığını gösterir. Bir klasöre tıklayınca içine girersin; hiçbir şey önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what takes how much space in your home folder. Click a folder to zoom in; nothing is preselected and items only go to the Trash."
          }
        }
      }
    },
    "files.map.other": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer küçük öğeler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other small items"
          }
        }
      }
    },
    "files.map.unreadable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunamadı (izin gerekli)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not be read (permission needed)"
          }
        }
      }
    },
    "files.map.up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir üst klasör"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up one level"
          }
        }
      }
    },
    "files.map.hint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük öğeler gruplanır; toplam boyut değişmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small items are grouped; the total size does not change."
          }
        }
      }
    },
    "files.map.share %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst klasörün %%%lld'i"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% of the folder"
          }
        }
      }
    },
    "files.hub.duplicates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicates"
          }
        }
      }
    },
    "files.dup.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya dosyalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate files"
          }
        }
      }
    },
    "files.dup.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği birebir aynı olan dosyaları bulur. Her grupta en az bir kopya her zaman kalır; hiçbiri önceden seçilmez ve yalnızca Çöp'e taşınır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds files with exactly the same content. Every group always keeps at least one copy; nothing is preselected and files only go to the Trash."
          }
        }
      }
    },
    "files.dup.empty.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya bulunmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No duplicates found"
          }
        }
      }
    },
    "files.dup.empty.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MB üzeri, içeriği aynı iki dosya yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no two files over 1 MB with the same content."
          }
        }
      }
    },
    "files.dup.keepOldest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En eskiyi tut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the oldest"
          }
        }
      }
    },
    "files.dup.keepShortest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En kısa yolu tut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the shortest path"
          }
        }
      }
    },
    "files.dup.clear": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçimi temizle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear selection"
          }
        }
      }
    },
    "files.dup.keepNote": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gruptaki son kopya seçilemez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last copy in a group cannot be selected."
          }
        }
      }
    },
    "files.dup.reclaimable %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam kazanılabilir: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaimable in total: %@"
          }
        }
      }
    },
    "files.dup.copies %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kopya"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld copies"
          }
        }
      }
    },
    "files.dup.wasted %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fazla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ extra"
          }
        }
      }
    },
    "files.fda.notice": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi ver: macOS tüm klasörleri tek seferde açar. Vermezsen her klasör için ayrı izin sorar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Full Disk Access: macOS then allows every folder at once. Without it, it asks for each folder separately."
          }
        }
      }
    },
    "files.fda.open": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ı aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "files.hub.shredder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalayıcı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shredder"
          }
        }
      }
    },
    "files.shred.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalayıcı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shredder"
          }
        }
      }
    },
    "files.shred.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin dosyaları kalıcı olarak siler. Çöp'e gitmez, geri alınamaz. Yalnızca senin eklediğin dosyalara dokunur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes the files you choose. They do not go to the Trash and cannot be restored. Only files you add are touched."
          }
        }
      }
    },
    "files.shred.add": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ekle…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add files…"
          }
        }
      }
    },
    "files.shred.drop": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları buraya bırak ya da Dosya ekle'ye bas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files here or press Add files"
          }
        }
      }
    },
    "files.shred.honest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dürüst not: SSD'lerde ve APFS'te dosyanın üzerine yazmak, eski verinin gittiğini garanti etmez (kopyala-yaz, aşınma dengeleme, TRIM). Burnish üzerine yazıyormuş gibi davranmaz; dosyayı kalıcı olarak siler. Gerçek güvenlik için FileVault'u aç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honest note: on SSDs and APFS, overwriting a file does not guarantee the old data is gone (copy-on-write, wear levelling, TRIM). Burnish does not pretend to overwrite; it deletes the file permanently. For real protection, turn on FileVault."
          }
        }
      }
    },
    "files.shred.acknowledge": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun geri alınamayacağını anlıyorum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand this cannot be undone"
          }
        }
      }
    },
    "files.shred.delete": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı olarak sil…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently…"
          }
        }
      }
    },
    "files.shred.blocked": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan yol: silinemez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected path: cannot be deleted"
          }
        }
      }
    },
    "files.shred.remove": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeden çıkar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from list"
          }
        }
      }
    },
    "files.shred.clear": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeyi temizle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear list"
          }
        }
      }
    },
    "files.hub.similar": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzer görseller"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar pictures"
          }
        }
      }
    },
    "files.similar.title": {
