{
  "sourceLanguage": "en",
  "strings": {
    "history.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        }
      }
    },
    "history.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish'in kaldırdığı her şey burada kayıtlıdır. Çöp'e taşınanları geri yükleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything Burnish removed is recorded here. Items moved to the Trash can be restored."
          }
        }
      }
    },
    "history.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey kaldırılmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been removed yet."
          }
        }
      }
    },
    "history.unavailable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem kaydı açılamadı. Bu yüzden bu oturumdaki işlemler burada görünmez ve geri yüklenemez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation log could not be opened, so actions in this session do not appear here and cannot be restored."
          }
        }
      }
    },
    "history.restore": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Yükle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        }
      }
    },
    "history.close": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "history.badge.restored": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklendi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored"
          }
        }
      }
    },
    "history.notice.dismiss": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "history.reclaimed %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam kazanılan alan: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total space reclaimed: %@"
          }
        }
      }
    },
    "history.notice.restored %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geri yüklendi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was restored."
          }
        }
      }
    },
    "history.outcome.trashed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp'e taşındı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to Trash"
          }
        }
      }
    },
    "history.outcome.deleted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı silindi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted permanently"
          }
        }
      }
    },
    "history.outcome.skipped": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped"
          }
        }
      }
    },
    "history.outcome.failed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silinemedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not be removed"
          }
        }
      }
    },
    "history.failure.notRestorable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe geri yüklenemez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item cannot be restored."
          }
        }
      }
    },
    "history.failure.missingFromTrash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe artık Çöp'te değil; muhtemelen Çöp boşaltıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item is no longer in the Trash; it was probably emptied."
          }
        }
      }
    },
    "history.failure.destinationOccupied": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski konumda şu an başka bir dosya var; üzerine yazmamak için geri yüklenmedi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another file is now at the original location; it was not restored so nothing is overwritten."
          }
        }
      }
    },
    "history.failure.moveFailed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma sırasında bir hata oluştu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred while moving it."
          }
        }
      }
    }
  },
  "version": "1.0"
}
