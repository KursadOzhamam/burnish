          "stringUnit": {
            "state": "translated",
            "value": "The action failed: "
          }
        }
      }
    },
    "protection.scan.progress %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe incelendi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items examined"
          }
        }
      }
    },
    "protection.scan.found %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bulgu"
          }
        },
        "en": {
