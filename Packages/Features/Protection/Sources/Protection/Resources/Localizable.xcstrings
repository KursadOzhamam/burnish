          }
        }
      }
    },
    "protection.message.quarantined": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantinaya alındı: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantined: "
          }
        }
      }
    },
    "protection.message.restored": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklendi: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored: "
          }
        }
      }
    },
    "protection.message.refused": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan bir konumda, taşınmadı: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a protected location, not moved: "
          }
        }
      }
    },
    "protection.message.failed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem yapılamadı: "
          }
        },
