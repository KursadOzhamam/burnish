            "state": "translated",
            "value": "Location"
          }
        }
      }
    },
    "protection.message.quarantined": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantinaya alındı: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantined: "
          }
        }
      }
    },
    "protection.message.restored": {
      "localizations": {
