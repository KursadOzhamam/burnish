    "protection.scan.progress %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe incelendi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items examined"
          }
        }
      }
    },
    "protection.scan.found %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bulgu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld findings"
          }
        }
      }
    },
    "protection.landing.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin güvenliğini kontrol edin, olası tehditleri inceleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your Mac's security and review possible threats."
          }
        }
      }
    },
    "protection.landing.hero.heading": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik durumunuzu öğrenin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find out where your security stands"
          }
        }
      }
    },
    "protection.landing.hero.message": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şüpheli yazılımları ve güvenlik ayarlarını kontrol edin. Koruma durumu ilk taramadan sonra gösterilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for suspicious software and security settings. The protection status is shown after the first scan."
          }
        }
      }
    },
    "protection.landing.hero.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talep üzerine çalışır; gerçek zamanlı antivirüs değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on demand; it is not real-time antivirus."
          }
        }
      }
    },
    "protection.landing.notScanned": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz taranmadı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not scanned yet"
          }
        }
      }
    },
    "protection.landing.list": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik kontrolleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security checks"
          }
        }
      }
    },
    "protection.landing.list.waiting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk tarama bekleniyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the first scan"
          }
        }
      }
    },
    "protection.landing.row.malware": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kötü amaçlı yazılımlar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Malware"
          }
        }
      }
    },
    "protection.landing.row.malware.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
