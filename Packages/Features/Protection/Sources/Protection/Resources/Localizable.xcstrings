    "protection.message.refused": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korunan bir konumda, taşınmadı: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a protected location, not moved: "
          }
        }
      }
    },
    "protection.message.failed": {
      "localizations": {
