{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "protection.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koruma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection"
          }
        }
      }
    },
    "protection.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish talep üzerine çalışan bir tarayıcıdır, gerçek zamanlı antivirüs değildir. macOS'un kendi savunmasını (XProtect, Gatekeeper, noter onayı) tamamlar, yerine geçmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish is an on-demand scanner, not real-time antivirus. It complements macOS's own defences (XProtect, Gatekeeper, notarisation); it does not replace them."
          }
        }
      }
    },
    "protection.tab.scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        }
      }
    },
    "protection.tab.quarantine": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantina"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantine"
          }
        }
      }
    },
    "protection.tab.system": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem durumu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System state"
          }
        }
      }
    },
    "protection.scan.start": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramayı başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the scan"
          }
        }
      }
    },
    "protection.scan.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "protection.scan.rescan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        }
      }
    },
    "protection.scan.what": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Masaüstü ve Uygulamalar taranır; ayrıca kendiliğinden başlayan işler (LaunchAgents/Daemons) okunur. Hiçbir şey silinmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Desktop and Applications are scanned, and the jobs that start by themselves (LaunchAgents/Daemons) are read. Nothing is deleted."
          }
        }
      }
    },
    "protection.scan.clean": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulgu yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found"
          }
        }
      }
    },
    "protection.scan.cleanDetail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan yerlerde bilinen bir zararlıyla eşleşen ya da kuralların işaretlediği bir şey çıkmadı. Bu, Mac'inin her yerinin temiz olduğunu garanti etmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in the scanned places matched a known threat or a rule. That does not guarantee the rest of your Mac is clean."
          }
        }
      }
    },
    "protection.finding.threat": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinen zararlı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known threat"
          }
        }
      }
    },
    "protection.finding.suspicious": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şüpheli"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspicious"
          }
        }
      }
    },
    "protection.finding.info": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information"
          }
        }
      }
    },
    "protection.finding.why": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden işaretlendi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why it was flagged"
          }
        }
      }
    },
    "protection.reason.knownBadHash": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanın içeriği bilinen bir zararlı listesinde: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's content is on a list of known threats: "
          }
        }
      }
    },
    "protection.reason.unsignedFromInternet": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzasız ve internetten gelmiş bir uygulama. Zararlı olduğu anlamına gelmez; kaynağına güveniyorsan sorun yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unsigned app that came from the internet. This does not mean it is harmful; if you trust where it came from, it is fine."
          }
        }
      }
    },
    "protection.reason.invalidSignature": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın imzası doğrulanamıyor: imzalandıktan sonra değiştirilmiş olabilir (dil temizliği, yama). Birçok sıradan uygulamada görülür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's signature does not check out: it may have been changed after signing (language cleanup, patching). This is common in ordinary apps."
          }
        }
      }
    },
    "protection.reason.danglingLaunchItem": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıçta çalışacak bir iş, ama programı artık yok: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A job set to run at startup whose program is gone: "
          }
        }
      }
    },
    "protection.reason.hiddenLaunchItem": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç işi, gizli veya geçici bir konumdaki programı çalıştırıyor: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A startup job that runs a program from a hidden or temporary location: "
          }
        }
      }
    },
    "protection.action.quarantine": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantinaya al"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantine"
          }
        }
      }
    },
    "protection.action.safe": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güvenli, bir daha sorma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is safe, do not ask again"
          }
        }
      }
    },
    "protection.action.reveal": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder'da göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "protection.action.restore": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        }
      }
    },
    "protection.quarantine.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantinada öğe yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in quarantine"
          }
        }
      }
    },
    "protection.quarantine.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karantinaya alınan öğeler silinmez: taşınır, çalıştırılamaz hale getirilir ve istediğin an geri yüklenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarantined items are not deleted: they are moved, made non-executable, and can be restored any time."
          }
        }
      }
    },
    "protection.system.gatekeeper": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper"
          }
        }
      }
    },
    "protection.system.sip": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Bütünlüğü Koruması (SIP)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Integrity Protection (SIP)"
          }
        }
      }
    },
    "protection.system.xprotect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "XProtect sürümü"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XProtect version"
          }
        }
      }
    },
    "protection.system.blocklist": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zararlı hash listesi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threat hash list"
          }
        }
      }
    },
    "protection.system.blocklistNone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü değil (imzalı liste bekleniyor)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not loaded (waiting for a signed list)"
          }
        }
      }
    },
    "protection.system.on": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        }
      }
    },
    "protection.system.off": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "protection.system.unknown": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlenemedi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not be determined"
          }
        }
      }
    },
    "protection.permissions.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik izinleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy permissions"
          }
        }
      }
    },
    "protection.permissions.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish bu izinleri yalnızca okur ve asla değiştirmez; değiştirmek için ilgili Sistem Ayarları paneli açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Burnish only reads these permissions and never changes them; to change one, the matching System Settings pane opens."
          }
        }
      }
    },
    "protection.permissions.needFDA": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzinleri okuyabilmek için Burnish'a Tam Disk Erişimi ver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Burnish Full Disk Access so it can read the permissions."
          }
        }
      }
    },
    "protection.permissions.openSettings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'ı aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "protection.permissions.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kategoride izinli uygulama yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app holds this permission."
          }
        }
      }
    },
    "protection.service.camera": {
      "localizations": {
