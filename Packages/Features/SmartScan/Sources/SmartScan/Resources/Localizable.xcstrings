{
  "sourceLanguage": "en",
  "strings": {
    "smartscan.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıllı Tarama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Scan"
          }
        }
      }
    },
    "smartscan.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif tarayıcıları birlikte çalıştırır. Hiçbir şey silinmez — sadece ne bulunduğunu gösterir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs the light scanners together. Nothing is deleted; it only shows what was found."
          }
        }
      }
    },
    "smartscan.idle.action": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramayı Başlat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Scan"
          }
        }
      }
    },
    "smartscan.cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "smartscan.found": {
      "comment": "Label above the running total of reclaimable space found.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        }
      }
    },
    "smartscan.finished.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama tamamlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan complete"
          }
        }
      }
    },
    "smartscan.finished.note": {
      "comment": "Reassurance that nothing was deleted. CLAUDE.md §4.6.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey silinmedi. Ne yapılacağını sen seçeceksin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was deleted. You choose what happens next."
          }
        }
      }
    },
    "smartscan.cancelled": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama iptal edildi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan cancelled"
          }
        }
      }
    },
    "smartscan.heavy.hint": {
      "comment": "Explains that heavy scanners are excluded from Smart Scan. CLAUDE.md §6.2.",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopya bulucu, benzer fotoğraflar ve Space Lens bu taramaya dahil değil — çok daha uzun sürerler, onları ayrıca başlatabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The duplicate finder, similar pictures and Space Lens are not part of this scan: they take much longer, and you can start them separately."
          }
        }
      }
    },
    "smartscan.itemsFound %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items"
          }
        }
      }
    },
    "smartscan.ready": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizlenmeye hazır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to clean"
          }
        }
      }
    },
    "smartscan.review": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçları İncele"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Results"
          }
        }
      }
    },
    "smartscan.rescan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Tara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Again"
          }
        }
      }
    },
    "smartscan.permission": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı klasörler okunamadı (Tam Disk Erişimi gerekli); onlar dahil değil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders could not be read (Full Disk Access needed); they are not included."
          }
        }
      }
    },
    "smartscan.additional %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca elle seçebileceğin %@ daha var."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is %@ more you can select by hand."
          }
        }
      }
    }
  },
  "version": "1.0"
}
